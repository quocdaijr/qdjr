APP_URL=https://qdjr.me

# Legacy blog backend. api.qdjr.me no longer resolves (NXDOMAIN), so this is
# left unset: /legacy-blogs/* then renders its "archive offline" state with no
# network requests. Point it at a live host to bring that surface back.
# API_URL=https://api.qdjr.me/v1

# Google Analytics measurement ID (optional; falls back to the built-in default)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Google Cloud Translation API key, only for npm run translate:posts
GOOGLE_TRANSLATE_API_KEY=
